enum FileFormat {
  pdf
  image
  txt
  docx
  xlsx
  csv
  pptx
  md
}

model File {
  id                String     @id @default(cuid())
  fileId            String     @unique
  fileFormat        FileFormat
  fileUrl           String
  fileName          String
  fileParsingStatus Boolean
  createAt          DateTime   @default(now())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}
